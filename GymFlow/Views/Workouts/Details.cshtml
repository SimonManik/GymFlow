@model GymFlow.Models.WorkoutPlan

@{
    ViewData["Title"] = "Plan Details";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@Model.Name</h1>
        <a asp-action="Index" asp-route-memberId="@Model.MemberId" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Description</h5>
            <p class="card-text">@(Model.Description ?? "No description provided.")</p>
            <p class="text-muted small">Created: @Model.CreatedAt.ToShortDateString()</p>
        </div>
    </div>

    <h3>Exercises</h3>
    <hr />

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Exercise</th>
                <th>Sets</th>
                <th>Reps</th>
                <th>Note</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Exercises.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No exercises added yet.</td>
                </tr>
            }
            else
            {
                @foreach (var ex in Model.Exercises)
                {
                    <tr>
                        <td><strong>@ex.ExerciseName</strong></td>
                        <td>@ex.Sets</td>
                        <td>@ex.Reps</td>
                        <td>@ex.Note</td>
                        <td>
                            <button class="btn btn-danger btn-sm text-white">Remove</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a class="btn btn-success">➕ Add Exercise</a>
    </div>
</div>