@model GymFlow.Models.WorkoutPlan

@{ ViewData["Title"] = "Plan Details"; }

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@Model.Name</h1>
        <a asp-action="Index" asp-route-memberId="@Model.MemberId" class="btn btn-outline-secondary">Zpět na plány</a>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
        <tr>
            <th>Den</th>
            <th>Akce</th>
        </tr>
        </thead>
        <tbody>
        @if (!Model.Exercises.Any())
        {
            <tr>
                <td colspan="2" class="text-center text-muted">Žádné dny.</td>
            </tr>
        }
        else
        {
            @foreach (var day in Model.Exercises)
            {
                <tr>
                    <td><strong>@day.Name</strong></td>
                    <td>
                        <a asp-action="DayDetails" asp-route-id="@day.Id" class="btn btn-info btn-sm">👁️ Detail</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-action="AddDay" asp-route-planId="@Model.Id" class="btn btn-success">➕ Přidat den</a>
    </div>
</div>