using GymFlow.Models;
using Microsoft.AspNetCore.Http.HttpResults;
using System.Numerics;
using System.Reflection.Emit;
using System.Runtime.Intrinsics.Arm;
using System.Threading.Channels;
using static Microsoft.EntityFrameworkCore.DbLoggerCategory.Model;

@model GymFlow.Models.WorkoutPlan

@{
    ViewData["Title"] = "Create Workout Plan";
}

< h1 > Create Plan for @Model.MemberId</h1>

<div class= "row" >
    < div class= "col-md-4" >
        < form asp - action = "Create" >
            < input type = "hidden" asp -for= "MemberId" />


            < div class= "form-group mb-3" >
                < label asp -for= "Name" class= "control-label" ></ label >
                < input asp -for= "Name" class= "form-control" placeholder = "e.g. Monday - Upper Body" />
                < span asp - validation -for= "Name" class= "text-danger" ></ span >
            </ div >

            < div class= "form-group mb-3" >
                < label asp -for= "Description" class= "control-label" ></ label >
                < textarea asp -for= "Description" class= "form-control" rows = "3" ></ textarea >
                < span asp - validation -for= "Description" class= "text-danger" ></ span >
            </ div >

            < div class= "form-group" >
                < button type = "submit" class= "btn btn-primary" > Save Plan </ button >
                < a asp - action = "Index" asp - route - memberId = "@Model.MemberId" class= "btn btn-secondary" > Cancel </ a >
            </ div >
        </ form >
    </ div >
</ div >