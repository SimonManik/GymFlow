@model GymFlow.Models.WorkoutExercise

@{
    ViewData["Title"] = "Add Exercise";
}
<p>Počet cviků: @(ViewBag.Exercises?.Count ?? 0)</p>

<h1>Add Exercise to Plan</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddExercise">
            <input type="hidden" asp-for="WorkoutPlanId" />

            <div class="form-group mb-3">
                <label asp-for="ExerciseName" class="control-label"></label>
                <input type="text" id="searchInput" class="form-control" placeholder="Hledat cvik..." />
                <input type="hidden" asp-for="ExerciseName" id="selectedExercise" />
                <ul id="exerciseList" class="list-group mt-1"></ul>    
                <span asp-validation-for="ExerciseName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Sets" class="control-label"></label>
                <input asp-for="Sets" class="form-control" type="number" min="1" />
                <span asp-validation-for="Sets" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reps" class="control-label"></label>
                <input asp-for="Reps" class="form-control" type="number" min="1" />
                <span asp-validation-for="Reps" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Note" class="control-label"></label>
                <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save Exercise</button>
                <a asp-action="Details" asp-route-id="@Model.WorkoutPlanId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
    const exercises = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Exercises as List<GymFlow.Models.Wger.ExerciseItem>));

    const searchInput = document.getElementById("searchInput");
    const exerciseList = document.getElementById("exerciseList");
    const selectedExercise = document.getElementById("selectedExercise");

    searchInput.addEventListener("input", function () {
        const query = searchInput.value.toLowerCase();
        exerciseList.innerHTML = ""; 

        if (query.length < 2) return; 

        const filtered = exercises.filter(e =>
            e.translations.some(t => t.language === 2 && t.name.toLowerCase().includes(query))
        );

        filtered.slice(0, 10).forEach(e => {
            const name = e.translations.find(t => t.language === 2)?.name;
            const li = document.createElement("li");
            li.className = "list-group-item list-group-item-action";
            li.textContent = name;

            li.addEventListener("click", function () {
                searchInput.value = name;
                selectedExercise.value = name;
                exerciseList.innerHTML = "";
            });

            exerciseList.appendChild(li);
        });
    });
</script>
}