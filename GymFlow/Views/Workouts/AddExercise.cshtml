@model GymFlow.Models.WorkoutExercise

@{
    ViewData["Title"] = "Add Exercise";
}

<h1>Add Exercise to Plan</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddExercise">
            <input type="hidden" asp-for="WorkoutPlanId" />

            <div class="form-group mb-3">
                <label asp-for="ExerciseName" class="control-label"></label>
                <input type="text" id="searchInput" class="form-control" placeholder="Hledat cvik..." />
                <input type="hidden" asp-for="ExerciseName" id="selectedExercise" />
                <ul id="exerciseList" class="list-group mt-1"></ul>    
                <span asp-validation-for="ExerciseName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Sets" class="control-label"></label>
                <input asp-for="Sets" class="form-control" type="number" min="1" />
                <span asp-validation-for="Sets" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reps" class="control-label"></label>
                <input asp-for="Reps" class="form-control" type="number" min="1" />
                <span asp-validation-for="Reps" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Note" class="control-label"></label>
                <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save Exercise</button>
                <a asp-action="Details" asp-route-id="@Model.WorkoutPlanId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>