@model IEnumerable<GymFlow.Models.WorkoutDay>

@{
    ViewData["Title"] = "Tréninkové dny";
}

<h1>Dny pro: @ViewBag.MemberName</h1>

<p>
    <a asp-action="AddDay" asp-route-memberId="@ViewBag.MemberId" class="btn btn-primary">➕ Přidat den</a>
</p>

<table class="table">
    <thead>
    <tr>
        <th>Den</th>
        <th>Akce</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var day in Model)
    {
        <tr>
            <td>@day.Name</td>
            <td>
                <a asp-action="DayDetails" asp-route-id="@day.Id" class="btn btn-info btn-sm">👁️ Detail cviků</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-controller="Members" asp-action="Index" class="btn btn-secondary mt-3">Zpět na seznam klientů</a>