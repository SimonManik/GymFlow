@{
    ViewData["Title"] = "Domovská stránka";
}

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 text-center text-lg-start">
            <h1 class="display-3 fw-bold mb-3">🏋️‍♂️ GymFlow</h1>
            <p class="lead text-muted mb-4">Ultimátní nástroj pro tvorbu cvičebních plánů, sledování progresu a správu tréninků.</p>

            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a class="btn btn-primary btn-lg px-4 me-md-2" asp-area="Identity" asp-page="/Account/Register">🚀 Začít cvičit</a>
                <a class="btn btn-outline-secondary btn-lg px-4" asp-area="Identity" asp-page="/Account/Login">🔑 Přihlásit se</a>
            </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0 text-center">
            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1470&auto=format&fit=crop" class="img-fluid rounded-3 shadow-lg" alt="Cvičení ve fitku" />
        </div>
    </div>

    <div class="row g-4 py-5 row-cols-1 row-cols-lg-3 text-center border-top">
        <div class="col">
            <div class="display-4 mb-3">📅</div>
            <h2>Vlastní plány</h2>
            <p class="text-muted">Rozděl si dny na partie a nastav si přesný počet sérií a opakování. Trénink přesně na míru.</p>
        </div>
        <div class="col">
            <div class="display-4 mb-3">🔥</div>
            <h2>Databáze cviků</h2>
            <p class="text-muted">Napojení na rozsáhlou databázi ti umožní rychle vybrat ty správné cviky pro tvůj cíl.</p>
        </div>
        <div class="col">
            <div class="display-4 mb-3">📈</div>
            <h2>Pro trenéry</h2>
            <p class="text-muted">Spravuj své klienty z jednoho místa. Přiděluj jim plány a sleduj, jak se postupně zlepšují.</p>
        </div>
    </div>
</div>