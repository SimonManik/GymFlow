@model IEnumerable<GymFlow.Models.Member>

@{
    ViewData["Title"] = "Members List";
}

<h1>Seznam členů fitka</h1>

<a asp-action="Create" class="btn btn-primary" style="margin-bottom: 15px;">➕ Přidat klienta</a>

<table class="table">
    <thead>
        <tr>
            <th>Jméno</th>
            <th>Příjmení</th>
            <th>E-mail</th>
            <th>Platnost do</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            // Highlight row if membership has expired
            <tr class="@(member.MembershipExpiry < DateTime.Now ? "table-danger" : "")">
                <td>@member.FirstName</td>
                <td>@member.LastName</td>
                <td>@member.Email</td>
                <td>@member.MembershipExpiry.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@member.Id" class="btn btn-sm btn-outline-primary" style="margin-right: 5px;">✏️ Upravit</a>

                    <a asp-controller="Workouts" asp-action="Index" asp-route-memberId="@member.Id" class="btn btn-sm btn-success" style="margin-right: 5px;">💪 Plány</a>

                    <form method="post" asp-action="Delete" asp-route-id="@member.Id" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this member?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            ❌ Smazat
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>